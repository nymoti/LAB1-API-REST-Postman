{
  "info": {
    "_postman_id": "6f1d2c84-3a5b-4e7c-9b10-2d8e4f6a1c01",
    "name": "LAB1 - Gestion Produits REST",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Lecture (GET)",
      "item": [
        {
          "name": "1. Lire un produit",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Temps de réponse < 500 ms\", () => pm.expect(pm.response.responseTime).to.be.below(500));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          }
        },
        {
          "name": "2. Rechercher des produits",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"products est un tableau\", () => pm.expect(pm.response.json().products).to.be.an(\"array\"));",
                  "pm.test(\"Temps de réponse < 500 ms\", () => pm.expect(pm.response.responseTime).to.be.below(500));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/search?q=phone",
              "host": ["{{baseUrl}}"],
              "path": ["products", "search"],
              "query": [{ "key": "q", "value": "phone" }]
            }
          }
        }
      ]
    },
    {
      "name": "Création (POST)",
      "item": [
        {
          "name": "3. Créer un produit",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200 ou 201\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "pm.test(\"Temps de réponse < 500 ms\", () => pm.expect(pm.response.responseTime).to.be.below(500));",
                  "pm.environment.set(\"createdProductId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Casque Audio Sans Fil\",\"price\":129.99,\"category\":\"audio\",\"stock\":25}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/products/add",
              "host": ["{{baseUrl}}"],
              "path": ["products", "add"]
            }
          }
        }
      ]
    },
    {
      "name": "Modification (PUT/PATCH)",
      "item": [
        {
          "name": "4. Remplacer un produit (PUT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Temps de réponse < 500 ms\", () => pm.expect(pm.response.responseTime).to.be.below(500));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Casque Audio Pro (Mise à jour)\",\"price\":149.99,\"category\":\"audio\",\"stock\":10}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          }
        },
        {
          "name": "5. Modifier le prix (PATCH)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Temps de réponse < 500 ms\", () => pm.expect(pm.response.responseTime).to.be.below(500));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"price\":139.99}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Suppression (DELETE)",
      "item": [
        {
          "name": "6. Supprimer un produit",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"isDeleted vaut true\", () => pm.expect(pm.response.json().isDeleted).to.eql(true));",
                  "pm.test(\"Temps de réponse < 500 ms\", () => pm.expect(pm.response.responseTime).to.be.below(500));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Erreurs",
      "item": [
        {
          "name": "7. Produit inexistant",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"message existe\", () => pm.expect(pm.response.json()).to.have.property(\"message\"));",
                  "pm.test(\"Temps de réponse < 500 ms\", () => pm.expect(pm.response.responseTime).to.be.below(500));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/99999",
              "host": ["{{baseUrl}}"],
              "path": ["products", "99999"]
            }
          }
        },
        {
          "name": "8. JSON mal formé",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Temps de réponse < 500 ms\", () => pm.expect(pm.response.responseTime).to.be.below(500));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Casque Audio Sans Fil\",\"price\":}"
            },
            "url": {
              "raw": "{{baseUrl}}/products/add",
              "host": ["{{baseUrl}}"],
              "path": ["products", "add"]
            }
          }
        }
      ]
    },
    {
      "name": "Exercices",
      "item": [
        {
          "name": "9. Produits par catégorie",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Tous les produits sont des smartphones\", () => {",
                  "    pm.response.json().products.forEach((product) => pm.expect(product.category).to.eql(\"smartphones\"));",
                  "});",
                  "pm.test(\"Temps de réponse < 500 ms\", () => pm.expect(pm.response.responseTime).to.be.below(500));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/category/smartphones",
              "host": ["{{baseUrl}}"],
              "path": ["products", "category", "smartphones"]
            }
          }
        },
        {
          "name": "10. Créer un utilisateur",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200 ou 201\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "pm.test(\"firstName correspond\", () => pm.expect(pm.response.json().firstName).to.eql(\"Amine\"));",
                  "pm.test(\"Temps de réponse < 500 ms\", () => pm.expect(pm.response.responseTime).to.be.below(500));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"firstName\":\"Amine\",\"lastName\":\"Benali\",\"age\":25}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/users/add",
              "host": ["{{baseUrl}}"],
              "path": ["users", "add"]
            }
          }
        },
        {
          "name": "11. Temps de réponse",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Temps de réponse < 500 ms\", () => pm.expect(pm.response.responseTime).to.be.below(500));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          }
        }
      ]
    }
  ]
}
